    "aws-cdk": "^2.1020.0",
    "eslint": "^9.30.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.35.0"
  }
}
